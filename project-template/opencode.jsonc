{
  "$schema": "https://opencode.ai/config.json",

  // Auto-loads project memory into every session — mechanical, not
  // dependent on the agent remembering to check. Resolves to nothing if
  // .opencode/memory/ doesn't exist yet (the first /log-decision or
  // /log-error run creates it, no manual setup needed).
  //
  // VERIFIED 2026-10-18 on this machine (OpenCode v2.0.26): a project
  // `instructions` array REPLACES the global one — it does not merge.
  // Evidence: a fresh session received only the AGENTS.md files plus
  // .opencode/memory/{decisions,errors}.md, while the global array's
  // concise.md / clarify.md / memory/profile.md never reached it. So the
  // global entries are repeated here with absolute paths. `~/` expansion
  // is unverified, hence absolute. New project = copy these five lines.
  //
  // Keep this list explicit (not a *.md glob): archive files
  // (.opencode/memory/*_archive.md) must never auto-load. A glob would
  // match them and grow context after every archive.
  //
  // profile.md is generated by `node ~/.config/opencode/scripts/memory.js
  // sync` from the vault Context.md. Re-run sync after changing prefs.
  "instructions": [
    "<HOME>/.config/opencode/instructions/concise.md",
    "<HOME>/.config/opencode/instructions/clarify.md",
    "<HOME>/.config/opencode/memory/profile.md",
    ".opencode/memory/decisions.md",
    ".opencode/memory/errors.md",
    ".opencode/memory/context.md"
  ]

  // Project-specific permission overrides go here — ONLY where this
  // project's stack genuinely differs from the global default. Permission
  // objects deep-merge with global config, so list just the deltas; you
  // don't need to restate the commit/push gate or anything else already
  // set globally. This — a permission delta here — is the DEFAULT way to
  // handle a non-JS stack's tester friction; a full `.opencode/agents/
  // tester.md` override is for when the tester's actual BEHAVIOR needs
  // to differ, not just its permissions. Don't reach for a full-file
  // override just to fix an allow-list — that forks the whole agent
  // definition and stops inheriting any future fixes to the global one.
  //
  // Example, for a Python project (so the tester agent isn't asked on
  // every pytest/ruff invocation). NOTE: if you uncomment this, you must
  // add a comma after the `]` on the instructions line above — this
  // block currently has no comma before it because it's commented out,
  // and this file has no other real content after it either way:
  //
  // "permission": {
  //   "bash": {
  //     "pytest*": "allow",
  //     "ruff*": "allow",
  //     "python -m*": "allow"
  //   }
  // }
}
