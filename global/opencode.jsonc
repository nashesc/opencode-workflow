{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["instructions/concise.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm *": "ask",
      "bun *": "ask",
      "npx *": "ask",
      "npm test*": "allow",
      "bun test*": "allow",

      "git commit*": "ask",
      "git push*": "ask",

      "rm -rf *": "deny",

      "*.env*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "*secrets*.json": "deny"
    },
    "edit": {
      "*": "allow",
      "package.json": "ask",
      "opencode.jsonc": "ask",
      ".opencode/**": "ask",
      ".opencode/memory/**": "allow",
      ".git/hooks/**": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/AppData/Local/Temp/**": "allow"
    },
    "doom_loop": "ask",
    "obsidian_delete_note": "deny",
    "obsidian_delete_*": "deny",
    "obsidian_move_note": "deny",
    "obsidian_move_file": "deny"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "subagent_depth": 2,
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bitbonsai/mcpvault@0.16.0",
        "YOUR_OBSIDIAN_VAULT_PATH"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },

  "provider": {
    "omni_route": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "YOUR_API_KEY_HERE"
      },
      "models": {
        "kr/claude-sonnet-4.5": {
          "name": "Sonnet-4.5",
          "limit": { "context": 200000, "output": 64000 }
        },
        "antigravity/claude-opus-4-6-thinking": {
          "name": "Opus-4.6-Thinking",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "antigravity/claude-sonnet-4-6": {
          "name": "Sonnet-4.6",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "antigravity/gpt-oss-120b-medium": {
          "name": "GPT-OSS-120B-Medium",
          "limit": { "context": 131072, "output": 32768 }
        },
        "antigravity/gemini-3.7-flash-high": {
          "name": "Gemini-3.7-Flash-High",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "antigravity/gemini-3.7-flash-medium": {
          "name": "Gemini-3.7-Flash-Medium",
          "limit": { "context": 1000000, "output": 64000 }
        }
      }
    }
  },
  "disabled_providers": [],
  "small_model": "groq/llama-3.1-8b-instant"
}
