{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["instructions/concise.md", "instructions/clarify.md", "~/.config/opencode/memory/profile.md"],
  "permission": {
    // Question tool stays allowed: clarification-by-default (instructions/clarify.md)
    // requires asking the user on consequential uncertainty.
    "question": "allow",
    "skill": {
      "logo-design": "ask"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm *": "ask",
      "bun *": "ask",
      "npx *": "ask",
      "npm test*": "allow",
      "bun test*": "allow",

      // memory.js: retrieval/sync are read-or-derive only. `add` stays "ask".
      // Prefix `node ` and keep the wildcard tight against the filename:
      // covers quoted + backslash Windows paths (`node "C:\...\memory.js"`)
      // and the unquoted form, while leaving `cat`/`type` on the script to
      // fall through to `*`: ask. `add` is listed BELOW allow so it wins.
      "node *memory.js*": "allow",
      "node *memory.js* add*": "ask",

      "git commit*": "ask",
      "git push*": "ask",

      "rm -rf *": "deny",

      "*.env*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "*secrets*.json": "deny"
    },
    "edit": {
      "*": "allow",
      "package.json": "ask",
      "opencode.jsonc": "ask",
      ".opencode/**": "ask",
      ".opencode/memory/**": "allow",
      ".git/hooks/**": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/AppData/Local/Temp/**": "allow"
    },
    "doom_loop": "ask",
    "obsidian_delete_*": "deny",
    "obsidian_move_note": "deny",
    "obsidian_move_file": "deny",
    // Surgical vault edits are denied; the memory commands (log-*, end-session,
    // recap, start-session) work through read_note + write_note only, so
    // write_note stays allowed. patch_note is listed in log-error.md as an
    // alternative but never required.
    "obsidian_patch_note": "deny",
    "obsidian_update_frontmatter": "deny",
    "obsidian_manage_tags": "deny"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "subagent_depth": 2,
  "mcp": {
    // Token gate (2026-10-15): obsidian OFF by default — mcpvault tool schemas
    // stay resident every step when enabled. Memory read/write goes through
    // scripts/memory.js (file-direct); enable this only to hand-edit notes.
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bitbonsai/mcpvault@0.16.0",
        "YOUR_OBSIDIAN_VAULT_PATH"
      ],
      "enabled": false,
      "timeout": 20000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },

  "provider": {
    "omni_route": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "YOUR_API_KEY_HERE"
      },
      "models": {
        "kr/claude-sonnet-4.5": {
          "name": "Sonnet-4.5",
          "limit": { "context": 200000, "output": 64000 }
        },
        "antigravity/claude-opus-4-6-thinking": {
          "name": "Opus-4.6-Thinking",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "antigravity/claude-sonnet-4-6": {
          "name": "Sonnet-4.6",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "antigravity/gpt-oss-120b-medium": {
          "name": "GPT-OSS-120B-Medium",
          "limit": { "context": 131072, "output": 32768 }
        },
        "antigravity/gemini-3.7-flash-high": {
          "name": "Gemini-3.7-Flash-High",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "antigravity/gemini-3.7-flash-medium": {
          "name": "Gemini-3.7-Flash-Medium",
          "limit": { "context": 1000000, "output": 64000 }
        }
      }
    }
  },
  "disabled_providers": []
  // No small_model here: it is a live-machine override (a provider outside
  // this distro's set), not a shared default. Top-level `model:` likewise
  // intentionally unset.
}
